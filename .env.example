# Copy to .env.local for local development. Everything is optional in dev:
# without Supabase, pilot sign-ups are logged to the server console instead.
# In production, a missing Supabase config makes the form say sign-ups aren't
# connected yet, rather than silently dropping them.

# Public site URL (canonical links, sitemap, OG images). Defaults to https://clarus.health
NEXT_PUBLIC_SITE_URL=

# Pilot sign-ups -> Supabase table `pilot_signups` (supabase/migrations/). Server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Confirmation email to the applicant + notification to the team, via Resend. Server-only.
RESEND_API_KEY=
PILOT_FROM_EMAIL="Clarus <pilot@clarus.health>"
PILOT_NOTIFY_EMAIL=hello@clarus.health

# Cloudflare Turnstile (spam protection on the pilot form). Leave both empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog product analytics. Leave empty to disable. Vercel Analytics turns on
# automatically when deployed on Vercel.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
